// NORDFORM — premium fashion / activewear store
// Money is stored in minor units (kopiyky / cents) as Int to avoid float errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Auth ───────────────────────────────

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Storefront account (optional — guests can check out without an account).
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  customer     Customer?
  wishlist     Wishlist[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ───────────────────────────── Catalog ──────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  image          String?
  seoTitle       String?
  seoDescription String?
  published      Boolean           @default(true)
  showInNav      Boolean           @default(false)
  position       Int               @default(0)
  parentId       String?
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]        @relation("CategoryTree")
  products       ProductCategory[]
  primaryFor     Product[]         @relation("PrimaryCategory")
  subFor         Product[]         @relation("SubCategory")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([parentId, position])
  @@index([published])
}

model Collection {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?
  heroImage      String?
  seoTitle       String?
  seoDescription String?
  published      Boolean             @default(true)
  position       Int                 @default(0)
  products       ProductCollection[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([published, position])
}

model Color {
  id       String           @id @default(cuid())
  name     String           @unique
  slug     String           @unique
  hex      String           @default("#000000")
  position Int              @default(0)
  variants ProductVariant[]
}

model Product {
  id               String  @id @default(cuid())
  sku              String  @unique
  name             String
  slug             String  @unique
  description      String?
  shortDescription String?
  brand            String?

  categoryId    String?
  category      Category? @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  subcategory   Category? @relation("SubCategory", fields: [subcategoryId], references: [id], onDelete: SetNull)

  price          Int
  compareAtPrice Int?
  costPrice      Int?
  currency       String @default("UAH")

  status     ProductStatus @default(DRAFT)
  featured   Boolean       @default(false)
  isNew      Boolean       @default(false)
  bestSeller Boolean       @default(false)
  onSale     Boolean       @default(false)

  rating      Float @default(0)
  reviewCount Int   @default(0)
  salesCount  Int   @default(0)

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  tags             String[] @default([])
  details          String?
  material         String?
  careInstructions String?
  shippingInfo     String?
  returnInfo       String?

  images      ProductImage[]
  variants    ProductVariant[]
  categories  ProductCategory[]
  collections ProductCollection[]
  reviews     Review[]
  wishlist    Wishlist[]
  orderItems  OrderItem[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, salesCount])
  @@index([status, featured])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  colorName String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  colorId        String?
  color          Color?      @relation(fields: [colorId], references: [id], onDelete: SetNull)
  size           String?
  price          Int?
  compareAtPrice Int?
  stock          Int         @default(0)
  position       Int         @default(0)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([productId, colorId, size])
  @@index([colorId])
  @@index([size])
  @@index([stock])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

// ───────────────────────── Customers & orders ─────────────────────────

model Customer {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String
  lastName    String?
  phone       String?
  city        String?
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders      Order[]
  ordersCount Int      @default(0)
  totalSpent  Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id               String        @id @default(cuid())
  number           Int           @unique @default(autoincrement())
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email            String
  phone            String
  firstName        String
  lastName         String
  status           OrderStatus   @default(NEW)
  paymentMethod    String
  paymentProvider  String
  paymentStatus    PaymentStatus @default(PENDING)
  paymentRef       String?
  deliveryMethod   String
  deliveryProvider String
  city             String
  deliveryAddress  String
  trackingNumber   String?
  subtotal         Int
  shippingCost     Int           @default(0)
  discount         Int           @default(0)
  total            Int
  currency         String        @default("UAH")
  promotionCode    String?
  comment          String?
  adminNote        String?
  items            OrderItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  sku       String
  color     String?
  size      String?
  image     String?
  unitPrice Int
  quantity  Int
  total     Int

  @@index([orderId])
  @@index([productId])
}

// ─────────────────────────── Cart & wishlist ───────────────────────────

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([visitorId, productId])
  @@index([userId])
}

// ─────────────────────────────── Content ───────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  rating    Int
  title     String?
  body      String
  size      String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([productId, status])
  @@index([status, createdAt])
}

enum BannerPlacement {
  ANNOUNCEMENT
  HOMEPAGE
  MEGA_MENU
  CATALOG
}

model Banner {
  id          String          @id @default(cuid())
  placement   BannerPlacement @default(HOMEPAGE)
  title       String
  subtitle    String?
  image       String?
  mobileImage String?
  buttonLabel String?
  link        String?
  position    Int             @default(0)
  active      Boolean         @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, active, position])
}

enum SectionType {
  HERO
  PRODUCT_CAROUSEL
  PRODUCT_GRID
  CATEGORY_GRID
  IMAGE_TEXT
  BANNER
  COLLECTION
  VIDEO
  TEXT
}

model HomepageSection {
  id           String      @id @default(cuid())
  type         SectionType
  label        String?
  title        String?
  subtitle     String?
  body         String?
  image        String?
  mobileImage  String?
  videoUrl     String?
  buttonLabel  String?
  buttonLink   String?
  button2Label String?
  button2Link  String?
  background   String?
  textColor    String?
  /// Type-specific options, e.g. { source: "new", limit: 8, slug: "essentials", layout: "left" }
  config       Json        @default("{}")
  position     Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([active, position])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id        String    @id @default(cuid())
  url       String    @unique
  pathname  String?
  filename  String
  mimeType  String
  size      Int       @default(0)
  width     Int?
  height    Int?
  alt       String?
  /// Original URL for files imported from the web (CSV import) — avoids re-downloading
  sourceUrl String?
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([filename])
  @@index([sourceUrl])
}

enum PromotionType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Promotion {
  id          String        @id @default(cuid())
  code        String        @unique
  description String?
  type        PromotionType @default(PERCENTAGE)
  /// Percent (1–100) for PERCENTAGE, minor units for FIXED
  value       Int           @default(0)
  minSubtotal Int           @default(0)
  usageLimit  Int?
  usageCount  Int           @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Singleton row with id = "default"
model Settings {
  id                    String   @id @default("default")
  storeName             String   @default("NORDFORM")
  tagline               String?
  accentColor           String   @default("#1f1f1f")
  currency              String   @default("UAH")
  freeShippingThreshold Int      @default(200000)
  shippingFlatRate      Int      @default(9000)
  contactEmail          String?
  contactPhone          String?
  instagramUrl          String?
  seoTitle              String?
  seoDescription        String?
  ogImage               String?
  sizeGuide             String?
  deliveryInfo          String?
  returnsInfo           String?
  lowStockThreshold     Int      @default(5)
  updatedAt             DateTime @updatedAt
}

/// Fixed-window counters used by the DB-backed rate limiter (works across serverless instances).
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}
