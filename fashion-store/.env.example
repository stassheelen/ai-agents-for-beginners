# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Neon / Vercel Postgres / Supabase / any Postgres 14+.
# For Neon use the pooled connection string (…-pooler…) with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. With Neon use the URL without "-pooler".
# Locally it can be the same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ── Auth.js (admin login) ───────────────────────────────────────────────
# Generate with: npx auth secret   or   openssl rand -base64 32
AUTH_SECRET=""

# ── Vercel Blob (image & video uploads, CSV image import) ───────────────
# Created automatically when you connect a Blob store to the Vercel project.
# Leave empty locally to store uploads in /public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=""

# ── Public site URL (sitemap, canonical URLs, payment callbacks) ────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Demo admin (created / updated by `npm run db:seed`) ─────────────────
# Never hard-coded in the frontend. Change the password after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# ── Optional integrations ───────────────────────────────────────────────
# Nova Poshta API key → city & branch autocomplete in checkout
NOVA_POSHTA_API_KEY=""
# LiqPay → online card payments (otherwise card orders use a manual invoice)
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""
# Force a specific card gateway id when several are configured (e.g. "liqpay")
PAYMENT_CARD_PROVIDER=""
# Extra remote image hosts allowed by next/image (comma separated)
IMAGE_REMOTE_HOSTS=""

# Google Search Console: value of content="…" from the HTML-tag verification method
GOOGLE_SITE_VERIFICATION=""

# ── Cloudflare R2 photo storage (preferred over Vercel Blob when all five are set) ──
# Bucket → Settings → Public access → R2.dev subdomain gives R2_PUBLIC_URL (https://pub-….r2.dev)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="vella-media"
R2_PUBLIC_URL=""
# Import: 1 = copy supplier photos into storage, 0 = link them (default: copy when R2 is set up)
# IMPORT_COPY_IMAGES=""
