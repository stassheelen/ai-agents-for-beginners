# ── Доступ планшетів до API ─────────────────────────────────────────────
# Ключі пристроїв через кому. Планшет надсилає ключ у заголовку x-api-key.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEVICE_API_KEYS=

# ── Microsoft Entra ID (App registration) ───────────────────────────────
# Дозвіл Microsoft Graph (Application): Sites.Selected (рекомендовано) або Sites.ReadWrite.All
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── SharePoint ──────────────────────────────────────────────────────────
# Або SP_SITE_ID, або SP_SITE_URL (id буде визначено автоматично).
SP_SITE_URL=https://contoso.sharepoint.com/sites/Production
SP_SITE_ID=
# Назва або ID списку подій (створюється скриптом npm run provision).
SP_EVENTS_LIST=ProductionEvents
# Необов'язково: список довідника продукції для GET /api/products.
SP_PRODUCTS_LIST=
