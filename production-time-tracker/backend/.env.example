# ── Доступ планшетів до API ─────────────────────────────────────────────
# Ключі пристроїв через кому. Планшет надсилає ключ у заголовку x-api-key.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEVICE_API_KEYS=

# ── Google Таблиця ──────────────────────────────────────────────────────
# URL вебдодатка Apps Script (google-sheets/Code.gs), закінчується на /exec.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Спільний секрет: той самий рядок, що SHARED_SECRET у властивостях скрипту.
GOOGLE_SCRIPT_SECRET=
